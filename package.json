{
  "name": "kodedock-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "tsx --test test/unit/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "test:e2e": "tsx --test e2e/*.test.ts",
    "test:all": "tsx --test test/unit/*.test.ts test/integration/*.test.ts e2e/*.test.ts",
    "graphify": "uvx --from graphifyy graphify extract . --code-only",
    "db:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.dev.yml down",
    "db:logs": "docker compose -f docker/docker-compose.dev.yml logs -f",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.14",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
