# =============================================================================
# KODEDOCK ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================

# Server Settings
PORT=4001
TZ=Asia/Kolkata

# PostgreSQL Configuration
POSTGRES_DB=kodedock
POSTGRES_USER=kodedock
POSTGRES_PASSWORD=kodedock_secret_change_me
DATABASE_URL=postgres://kodedock:kodedock_secret_change_me@localhost:5432/kodedock

# Redis Configuration
REDIS_PASSWORD=kodedock_redis_secret_change_me
REDIS_URL=redis://:kodedock_redis_secret_change_me@localhost:6379

# JWT Cryptographic Signing Key (Generate with: openssl rand -base64 32)
JWT_SECRET=kodedock-super-secret-jwt-key-change-in-production-2026

# SeaweedFS S3-Compatible Storage
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=kodedock_seaweed
S3_SECRET_KEY=kodedock_seaweed_secret
S3_BUCKET=kodedock-media
S3_REGION=us-east-1

# OAuth Providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Next.js Internal Gateway
CORE_ENGINE_URL=http://localhost:4001
