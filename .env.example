# ==============================================================================
# KODEDOCK ENVIRONMENT CONFIGURATION (100% Self-Hosted - Zero BaaS)
# ==============================================================================

# Server & Gateway Port
PORT=4000
NODE_ENV=development

# Better Auth Secret (32-byte secure key) & Base URL
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=kodedock_super_secret_auth_key_replace_in_prod_32chars!
BETTER_AUTH_URL=http://localhost:4000

# Self-Hosted Database
# Development: SQLite local file (zero configuration required)
# Production: postgresql://user:password@localhost:5432/kodedock
DATABASE_URL=kodedock.db

# Social OAuth Credentials (Optional in local dev, needed for GitHub/Google login)
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allowed Frontend Origins (CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
