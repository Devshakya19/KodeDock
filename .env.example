# ==========================================
# ⚓ KodeDock Unified Environment Configuration
# ==========================================

# --- Node & Environment ---
ENVIRONMENT=development
LOG_LEVEL=debug
APP_NAME=kodedock
APP_URL=http://localhost:3000
API_URL=http://localhost:8080

# --- Server Ports ---
BACKEND_PORT=8080
FRONTEND_PORT=3000
STORAGE_PORT=8333
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- PostgreSQL Database (pgvector enabled) ---
POSTGRES_DB=kodedock
POSTGRES_USER=kodedock_admin
POSTGRES_PASSWORD=SuperSecretKodedockSecurePassword2026!
DATABASE_URL=postgres://kodedock_admin:SuperSecretKodedockSecurePassword2026!@postgres:5432/kodedock
DATABASE_MAX_CONNECTIONS=50

# --- Redis In-Memory Cache & Pub/Sub ---
REDIS_PASSWORD=SuperSecretRedisPassword2026!
REDIS_URL=redis://:SuperSecretRedisPassword2026!@redis:6379
REDIS_MAX_CONNECTIONS=20

# --- SeaweedFS / S3 Object Storage ---
S3_ENDPOINT=http://storage:8333
S3_PUBLIC_BUCKET=kodedock-public-assets
S3_VAULT_BUCKET=kodedock-vault-deliverables
S3_REGION=us-east-1
S3_ACCESS_KEY=kodedock_s3_admin_key
S3_SECRET_KEY=kodedock_s3_admin_secret_super_secure_key

# --- Cryptography & Security Secrets ---
# Minimum 32 bytes random string for JWT HS256 / EdDSA
JWT_SECRET=kodedock_jwt_ultra_secret_signing_key_at_least_32_bytes_2026!
JWT_ACCESS_EXPIRY_SECONDS=900       # 15 minutes
JWT_REFRESH_EXPIRY_SECONDS=604800   # 7 days

# Master 32-byte AES-256-GCM encryption key for TOTP secrets & PAN numbers at rest (hex-encoded)
MASTER_ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Master Ed25519 Private Key for DRM Software Licensing (Base64 encoded)
DRM_ED25519_PRIVATE_KEY_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- Indian Fintech & Payment Gateways ---
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_key_2026

# --- SMTP / Email Delivery (Mailpit for local development) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@kodedock.com
SMTP_FROM_NAME="KodeDock Marketplace"

# --- OAuth 2.0 Providers ---
GITHUB_CLIENT_ID=github_placeholder_client_id
GITHUB_CLIENT_SECRET=github_placeholder_client_secret
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback

GOOGLE_CLIENT_ID=google_placeholder_client_id
GOOGLE_CLIENT_SECRET=google_placeholder_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
