# =============================================================================
# KodeDock - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Only Razorpay keys are REQUIRED to be changed. Everything else has working
# defaults for local development.
# =============================================================================

# Razorpay Payment Gateway (REQUIRED - get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Database (defaults work with docker-compose)
POSTGRES_PASSWORD=kodedock_secret

# Redis (defaults work with docker-compose)
REDIS_PASSWORD=kodedock_redis_secret

# JWT Secret (change in production)
JWT_SECRET=kodedock-super-secret-jwt-key-change-in-production-2024
