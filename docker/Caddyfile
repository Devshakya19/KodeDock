{
    admin off
    auto_https off
}

# Common reusable configuration snippet for APIs, WebSockets, Storage & Security
(common_api) {
    # Security Headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Enable Compression
    encode zstd gzip

    # Backend API & WebSocket Routes
    handle /api/* {
        reverse_proxy backend:8080 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /ws/* {
        reverse_proxy backend:8080 {
            header_up Upgrade {http.request.header.Upgrade}
            header_up Connection {http.request.header.Connection}
            header_up X-Real-IP {remote_host}
        }
    }

    # S3 Object Storage Gateway
    handle /s3/* {
        uri strip_prefix /s3
        reverse_proxy storage:8333
    }

    # Health Check Endpoint for Load Balancers
    handle /healthz {
        respond "OK" 200
    }
}

# -------------------------------------------------------------
# 1. Platform Application (Buyer, Seller, Explore, Auth)
#    Accessible at: http://app.localhost
# -------------------------------------------------------------
http://app.localhost, app.localhost:80 {
    import common_api

    handle {
        reverse_proxy platform-ui:3000
    }
}

# -------------------------------------------------------------
# 2. Marketing Application & Default Gateway
#    Accessible at: http://localhost or directly by IP
# -------------------------------------------------------------
http://localhost, :80 {
    import common_api

    handle {
        reverse_proxy kodedock-ui:3000
    }
}
