# ── KodeDock API Gateway Container ──────────────────────────────────────────
FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@11.26.0 --activate
WORKDIR /app

# ── Build Stage ─────────────────────────────────────────────────────────────
FROM base AS builder
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @kodedock/backend run build

# ── Production Runtime Stage ────────────────────────────────────────────────
FROM node:22-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000
ENV HOSTNAME="0.0.0.0"

# Security: run as non-root user in production
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 -g nodejs kodedock

COPY --from=builder --chown=kodedock:nodejs /app /app

USER kodedock
EXPOSE 4000

CMD ["./node_modules/.bin/tsx", "src/api/server.ts"]
