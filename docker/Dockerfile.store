# ── KodeDock Store Marketplace Container (Port 3003) ─────────────────────────
FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@11.26.0 --activate
WORKDIR /app

# ── Build Stage ─────────────────────────────────────────────────────────────
FROM base AS builder
COPY . .
RUN pnpm install --frozen-lockfile
ENV NEXT_TELEMETRY_DISABLED=1
ENV INTERNAL_API_URL="http://api:4000"
RUN pnpm --filter @kodedock/store run build

# ── Production Runtime Stage ────────────────────────────────────────────────
FROM node:22-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3003
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1
ENV INTERNAL_API_URL="http://api:4000"

# Security: run as non-root user in production
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 -g nodejs kodedock

# Next.js standalone bundle & static assets
COPY --from=builder --chown=kodedock:nodejs /app/apps/store/.next/standalone ./
COPY --from=builder --chown=kodedock:nodejs /app/apps/store/.next/static ./apps/store/.next/static
COPY --from=builder --chown=kodedock:nodejs /app/apps/store/public ./apps/store/public

USER kodedock
EXPOSE 3003

CMD ["node", "apps/store/server.js"]
