# ── KodeDock Buyer Portal Container ─────────────────────────────────────────
FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@11.26.0 --activate
WORKDIR /app

# ── Build Stage ─────────────────────────────────────────────────────────────
FROM base AS builder
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY . .
RUN pnpm install --frozen-lockfile
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @kodedock/portal run build

# ── Production Runtime Stage ────────────────────────────────────────────────
FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3002
ENV NEXT_TELEMETRY_DISABLED=1

# Next.js standalone bundle & static assets
COPY --from=builder /app/apps/portal/.next/standalone ./
COPY --from=builder /app/apps/portal/.next/static ./apps/portal/.next/static
COPY --from=builder /app/apps/portal/public ./apps/portal/public

EXPOSE 3002
CMD ["node", "apps/portal/server.js"]
