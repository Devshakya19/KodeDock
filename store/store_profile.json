{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreatorStoreProfile",
  "type": "object",
  "properties": {
    "store_handle": {
      "type": "string",
      "pattern": "^[a-z0-9-_]{3,64}$",
      "description": "Unique URL-safe handle for the creator shop"
    },
    "store_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128
    },
    "tagline": {
      "type": "string",
      "maxLength": 255
    },
    "about_markdown": {
      "type": "string"
    },
    "banner_storage_key": {
      "type": "string"
    },
    "logo_storage_key": {
      "type": "string"
    },
    "social_links": {
      "type": "object",
      "properties": {
        "github": { "type": "string", "format": "uri" },
        "twitter": { "type": "string", "format": "uri" },
        "discord": { "type": "string", "format": "uri" },
        "youtube": { "type": "string", "format": "uri" },
        "website": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "featured_product_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "maxItems": 6
    },
    "is_verified_creator": {
      "type": "boolean"
    }
  },
  "required": ["store_handle", "store_name"]
}
